query I nosort
SELECT eCol
  FROM t1
 WHERE (c<=d-2 OR c>=d+2)
   AND (a>b-2 AND a<b+2)
 ORDER BY 1
----
165

query I nosort
SELECT a+b*2+c*3+d*4+eCol*5
  FROM t1
 WHERE (eCol>a AND eCol<b)
   AND (eCol>c OR eCol<d)
   AND (c<=d-2 OR c>=d+2)
 ORDER BY 1
----
3331

query II nosort
SELECT b-c,
       a+b*2+c*3+d*4+eCol*5
  FROM t1
 WHERE b>c
   AND a>b
   AND (eCol>a AND eCol<b)
 ORDER BY 2,1
----

query I nosort
SELECT CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
        WHEN a<b+3 THEN 333 ELSE 444 END
  FROM t1
 WHERE (eCol>a AND eCol<b)
   AND d>eCol
   AND (c<=d-2 OR c>=d+2)
 ORDER BY 1
----
222

query III nosort
SELECT d-eCol,
       c-d,
       a
  FROM t1
 WHERE b>c
   AND (eCol>a AND eCol<b)
   AND c>d
 ORDER BY 1,2,3
----
-2
3
191

query I nosort
SELECT abs(b-c)
  FROM t1
 WHERE (c<=d-2 OR c>=d+2)
   AND c>d
   AND (a>b-2 AND a<b+2)
 ORDER BY 1
----

query II nosort
SELECT c,
       a+b*2+c*3+d*4
  FROM t1
 WHERE b>c
   AND (a>b-2 AND a<b+2)
   AND (eCol>a AND eCol<b)
 ORDER BY 2,1
----

query II nosort
SELECT abs(a),
       d
  FROM t1
 WHERE (eCol>a AND eCol<b)
   AND a>b
   AND c>d
 ORDER BY 2,1
----

query II nosort
SELECT c,
       CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
        WHEN a<b+3 THEN 333 ELSE 444 END
  FROM t1
 WHERE (eCol>a AND eCol<b)
   AND b>c
   AND (c<=d-2 OR c>=d+2)
 ORDER BY 1,2
----
