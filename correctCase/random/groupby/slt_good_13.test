skipif postgresql # PostgreSQL requires AS when renaming output columns
query I rowsort
SELECT cor0.col0 col0 FROM tab2, tab2 cor0 GROUP BY cor0.col0
----
15
91
92

query I rowsort
SELECT col0 AS col0 FROM tab0 cor0 GROUP BY cor0.col0
----
26
43
83

