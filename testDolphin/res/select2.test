query IIIIII rowsort
SELECT (a+b+c+d+eCol)/5,
       a+b*2+c*3+d*4+eCol*5,
       d-eCol,
       a+b*2,
       CASE a+1 WHEN b THEN 111 WHEN c THEN 222
        WHEN d THEN 333  WHEN eCol THEN 444 ELSE 555 END,
       c
  FROM t1
 WHERE c BETWEEN b-2 AND d+2
   AND b>c
   AND a>b

query I rowsort
SELECT a+b*2+c*3
  FROM t1
 WHERE eCol+d BETWEEN a+b-10 AND c+130
    OR c>d
    OR a IS NULL

