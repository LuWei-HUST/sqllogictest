SELECT ALL + col2 * col0 DIV + 2 FROM tab1 AS cor0

skipif mysql # not compatible
query I rowsort label-9987
SELECT ALL + col2 * col0 / + 2 FROM tab1 AS cor0

query I rowsort
SELECT - col0 - + 79 AS col0 FROM tab2 AS cor0

query I rowsort
SELECT col2 * col1 - col0 FROM tab1 AS cor0
----
1168
1401
506

onlyif mysql # use DIV operator for integer division
query I rowsort label-9990
SELECT distinct + cor0.col0 + ( - col1 ) DIV - cor0.col1 FROM tab0 AS cor0

skipif mysql # not compatible
query I rowsort label-9990
SELECT distinct + cor0.col0 + ( - col1 ) / - cor0.col1 FROM tab0 AS cor0

query I rowsort
SELECT ALL + col2 + ( col1 ) AS col2 FROM tab0 AS cor0
----
119
173
98

query I rowsort
SELECT ALL + col2 * col1 + cor0.col2 FROM tab2 AS cor0
----
1560
684
864

skipif postgresql # PostgreSQL requires AS when renaming output columns
query I rowsort
SELECT distinct + col0 + 30 * col1 col1 FROM tab2 AS cor0

query I rowsort
SELECT col2 + col0 * + col0 * + 11 AS col0 FROM tab2

query I rowsort
SELECT distinct - cor0.col0 * + 84 + col1 AS col0 FROM tab2 AS cor0

skipif mysql # not compatible
query I rowsort
SELECT distinct - - col1 * CAST ( col1 AS REAL ) FROM tab2 AS cor0

query I rowsort
SELECT distinct 29 AS col0 FROM tab0, tab1 AS cor0, tab0 AS cor1

skipif mysql # not compatible
query I rowsort
SELECT ALL col2 * - CAST ( + 77 AS REAL ) * + col1 FROM tab0 AS cor0

